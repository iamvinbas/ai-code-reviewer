\f2\b0\fs26 \cf0 name: AI Code Review\
\
on:\
  pull_request:\
    types: [opened, synchronize, reopened]\
    # Non revieware if \'e8 solo docs\
    paths-ignore:\
      - "**.md"\
      - "docs/**"\
\
permissions:\
  pull-requests: write\
  contents: read\
\
jobs:\
  review:\
    runs-on: ubuntu-latest\
    \
    steps:\
      - name: Checkout code\
        uses: actions/checkout@v4\
        with:\
          fetch-depth: 0\
\
      - name: Setup Node.js\
        uses: actions/setup-node@v4\
        with:\
          node-version: "18"\
\
      - name: Install dependencies\
        run: npm ci\
\
      - name: Run AI Code Review\
        env:\
          GITHUB_TOKEN: $\{\{ secrets.GITHUB_TOKEN \}\}\
          CLAUDE_API_KEY: $\{\{ secrets.CLAUDE_API_KEY \}\}\
          GITHUB_REPOSITORY: $\{\{ github.repository \}\}\
          GITHUB_EVENT_PATH: $\{\{ github.event_path \}\}\
        run: node src/index.js\
\
      - name: Comment on failure\
        if: failure()\
        uses: actions/github-script@v7\
        with:\
          script: |\
            github.rest.issues.createComment(\{\
              issue_number: context.issue.number,\
              owner: context.repo.owner,\
              repo: context.repo.repo,\
              body: '\uc0\u9888 \u65039  AI Code Review encountered an error. Check the [workflow logs](https://github.com/$\{\{ github.repository \}\}/actions/runs/$\{\{ github.run_id \}\}).'\
            \})\
