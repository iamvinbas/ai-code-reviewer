\f2\b0\fs26 \cf0 require("dotenv").config();\
const GitHubClient = require("./github-client");\
const ClaudeClient = require("./claude-client");\
const CodeAnalyzer = require("./code-analyzer");\
\
async function main() \{\
  // Leggi da GitHub Action context\
  const \{\
    GITHUB_TOKEN,\
    CLAUDE_API_KEY,\
    GITHUB_REPOSITORY,\
    GITHUB_EVENT_PATH,\
  \} = process.env;\
\
  if (!GITHUB_TOKEN || !CLAUDE_API_KEY) \{\
    throw new Error("Missing required environment variables");\
  \}\
\
  // Parse GitHub event\
  const fs = require("fs");\
  const event = JSON.parse(fs.readFileSync(GITHUB_EVENT_PATH, "utf8"));\
  \
  const [owner, repo] = GITHUB_REPOSITORY.split("/");\
  const pullRequest = event.pull_request;\
  const commitSha = event.pull_request.head.sha;\
\
  // Esegui review\
  const github = new GitHubClient(GITHUB_TOKEN);\
  const claude = new ClaudeClient(CLAUDE_API_KEY);\
  const analyzer = new CodeAnalyzer(github, claude);\
\
  const issues = await analyzer.analyzePR(\
    owner,\
    repo,\
    pullRequest.number,\
    commitSha\
  );\
\
  if (issues.length > 0) \{\
    await analyzer.postReviewComments(\
      owner,\
      repo,\
      pullRequest.number,\
      issues,\
      commitSha\
    );\
  \} else \{\
    console.log("No issues found! \uc0\u55356 \u57225 ");\
  \}\
\}\
\
main().catch(error => \{\
  console.error("Fatal error:", error);\
  process.exit(1);\
\});\
