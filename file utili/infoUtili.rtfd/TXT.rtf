\f2\b0\fs26 \cf0 class CodeAnalyzer \{\
  constructor(githubClient, claudeClient) \{\
    this.github = githubClient;\
    this.claude = claudeClient;\
  \}\
\
  async analyzePR(owner, repo, pull_number, commitSha) \{\
    console.log(`Analyzing PR #$\{pull_number\}...`);\
\
    // 1. Scarica i cambiamenti\
    const changes = await this.github.getPRChanges(owner, repo, pull_number);\
    console.log(`Found $\{changes.length\} files to review`);\
\
    // 2. Per ogni file, chiama Claude\
    const allIssues = [];\
    \
    for (const file of changes) \{\
      console.log(`Reviewing $\{file.filename\}...`);\
      \
      try \{\
        const issues = await this.claude.reviewCode(\
          file.filename,\
          file.patch\
        );\
        \
        for (const issue of issues) \{\
          allIssues.push(\{\
            ...issue,\
            filename: file.filename,\
            commitSha,\
          \});\
        \}\
      \} catch (error) \{\
        console.error(`Error reviewing $\{file.filename\}:`, error);\
      \}\
\
      // Rate limiting\
      await this.sleep(500);\
    \}\
\
    return allIssues;\
  \}\
\
  async postReviewComments(owner, repo, pull_number, issues, commitSha) \{\
    // Raggrupa per severity\
    const critical = issues.filter(i => i.severity === "critical");\
    const warnings = issues.filter(i => i.severity === "warning");\
    const suggestions = issues.filter(i => i.severity === "suggestion");\
\
    // Post commenti per ogni issue\
    let postedCount = 0;\
    for (const issue of issues) \{\
      try \{\
        const commentBody = this.formatComment(issue);\
        \
        await this.github.postComment(\
          owner,\
          repo,\
          pull_number,\
          commentBody,\
          issue.line,\
          issue.filename,\
          commitSha\
        );\
        \
        postedCount++;\
      \} catch (error) \{\
        console.error("Error posting comment:", error);\
      \}\
    \}\
\
    // Post summary comment\
    const summaryBody = this.formatSummary(critical, warnings, suggestions);\
    await this.github.postGeneralComment(owner, repo, pull_number, summaryBody);\
\
    console.log(`Posted $\{postedCount\} review comments`);\
  \}\
\
  formatComment(issue) \{\
    const severityEmoji = \{\
      critical: "\uc0\u55357 \u56628 ",\
      warning: "\uc0\u55357 \u57313 ",\
      suggestion: "\uc0\u55357 \u56481 ",\
    \};\
\
    return `$\{severityEmoji[issue.severity]\} **$\{issue.severity.toUpperCase()\}**\
\
$\{issue.message\}\
\
**Suggestion:** $\{issue.suggestion\}\
\
<details>\
<summary>Why?</summary>\
\
$\{issue.explanation\}\
</details>`;\
  \}\
\
  formatSummary(critical, warnings, suggestions) \{\
    return `## \uc0\u55358 \u56598  AI Code Review Summary\
\
**$\{critical.length\}** critical issues | **$\{warnings.length\}** warnings | **$\{suggestions.length\}** suggestions\
\
$\{critical.length > 0 ? `### \uc0\u55357 \u56628  Critical\\n$\{critical.map(i => `- $\{i.message\}`).join("\\n")\}\\n` : ""\}\
\
$\{warnings.length > 0 ? `### \uc0\u55357 \u57313  Warnings\\n$\{warnings.map(i => `- $\{i.message\}`).join("\\n")\}\\n` : ""\}\
\
$\{suggestions.length > 0 ? `### \uc0\u55357 \u56481  Suggestions\\n$\{suggestions.map(i => `- $\{i.message\}`).join("\\n")\}\\n` : ""\}\
\
---\
*Powered by AI Code Reviewer Bot* \uc0\u9881 \u65039 `;\
  \}\
\
  sleep(ms) \{\
    return new Promise(resolve => setTimeout(resolve, ms));\
  \}\
\}\
\
module.exports = CodeAnalyzer;\
