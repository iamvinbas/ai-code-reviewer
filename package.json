{
  "name": "acr-review",
  "version": "0.1.0",
  "description": "Local AI code review in your terminal — before you commit, push or merge. Free, private, works with local models.",
  "type": "module",
  "bin": {
    "acr": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "code-review",
    "ai",
    "llm",
    "git",
    "pre-commit",
    "cli",
    "ollama"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamvinbas/ai-code-reviewer.git"
  },
  "bugs": {
    "url": "https://github.com/iamvinbas/ai-code-reviewer/issues"
  },
  "homepage": "https://github.com/iamvinbas/ai-code-reviewer#readme",
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/picomatch": "^4.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
